CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128

# Use the custom partition table (larger factory app + LittleFS storage)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 4 MB flash (partition table spans 4 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ---- Power saving: keep the BLE link alive via modem sleep ----
# Modem sleep (RF sleeps between BLE connection events). The CPU stays at full
# speed (160 MHz) -- no dynamic frequency scaling / down-clocking.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
# Main crystal is the only low-power clock usable for a BLE connection on
# boards without an external 32 kHz crystal (RTC_CLK_SRC_INT_RC is too coarse).
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
