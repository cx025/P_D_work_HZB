.page {
  padding: 34rpx 26rpx 60rpx;
  color: #172b49;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 26rpx 28rpx 34rpx;
  border: 1rpx solid #d9e9ff;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 58%, #e5f8f8 100%);
  box-shadow: 0 14rpx 42rpx rgba(46, 106, 177, .09);
}

.hero::after {
  position: absolute;
  top: -96rpx;
  right: -52rpx;
  width: 250rpx;
  height: 250rpx;
  border: 2rpx solid rgba(36, 120, 242, .12);
  border-radius: 50%;
  content: "";
}

.eyebrow {
  display: flex;
  align-items: center;
  color: #4c79ad;
  font-size: 19rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.pulse-dot,
.live-chip-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #28c69a;
  box-shadow: 0 0 0 6rpx rgba(40, 198, 154, .13);
}

.title {
  margin-top: 18rpx;
  color: #142c4e;
  font-size: 43rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.subtitle {
  margin-top: 10rpx;
  color: #68809e;
  font-size: 24rpx;
  line-height: 1.6;
}

.card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #e2eaf4;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(29, 66, 112, .07);
}

.connection-row,
.connection-state,
.section-heading,
.setting-heading,
.power-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.connection-row {
  min-height: 70rpx;
  gap: 14rpx;
}

.connection-state {
  min-width: 0;
  flex: 1;
  justify-content: flex-start;
}

.dot {
  width: 17rpx;
  height: 17rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #a6b5c8;
}

.dot.online {
  background: #24bf92;
  box-shadow: 0 0 0 7rpx rgba(36, 191, 146, .12);
}

.connection-title {
  overflow: hidden;
  max-width: 390rpx;
  color: #1c3454;
  font-size: 26rpx;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connection-caption,
.section-subtitle {
  margin-top: 5rpx;
  color: #8798ad;
  font-size: 20rpx;
}

.primary,
.secondary,
.power-button {
  margin: 0;
  border: 0;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.primary {
  color: #ffffff;
  background: linear-gradient(110deg, #287df5, #31a2ed);
  box-shadow: 0 8rpx 18rpx rgba(36, 120, 242, .2);
}

.secondary {
  color: #48627f;
  background: #edf3fa;
}

.compact {
  padding: 0 20rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.empty {
  margin-top: 18rpx;
  padding: 19rpx;
  border-radius: 14rpx;
  color: #647d9a;
  background: #f3f8ff;
  font-size: 22rpx;
  line-height: 1.6;
}

.device-list {
  margin-top: 22rpx;
}

.section-label {
  margin-bottom: 10rpx;
  color: #8294aa;
  font-size: 21rpx;
}

.device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid #e8eef5;
}

.device-name {
  color: #233d60;
  font-size: 25rpx;
  font-weight: 700;
}

.target-badge {
  margin-left: 10rpx;
  color: #159f78;
  font-size: 19rpx;
}

.device-id {
  max-width: 410rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #91a0b2;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connect-mark {
  color: #2478f2;
  font-size: 23rpx;
  font-weight: 700;
}

.monitor-banner {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #d8e9ff;
  border-radius: 18rpx;
  background: linear-gradient(105deg, #eff6ff, #effbfa);
}

.monitor-copy {
  flex: 1;
}

.monitor-label {
  color: #7189a5;
  font-size: 20rpx;
}

.monitor-value {
  margin-top: 8rpx;
  color: #1f5fb6;
  font-size: 28rpx;
  font-weight: 750;
}

.live-time {
  margin-right: 22rpx;
  text-align: right;
}

.live-value {
  margin-top: 6rpx;
  color: #1d3555;
  font-size: 24rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.seat-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 2rpx solid #d6e1ee;
  border-radius: 50%;
  background: #ffffff;
}

.seat-ring {
  width: 23rpx;
  height: 23rpx;
  border-radius: 50%;
  background: #b8c5d4;
}

.seat-indicator.occupied {
  border-color: #b3e8dc;
}

.seat-indicator.occupied .seat-ring {
  background: #22bd91;
  box-shadow: 0 0 0 8rpx rgba(34, 189, 145, .13);
}

.power-row {
  margin-top: 22rpx;
  padding-top: 21rpx;
  border-top: 1rpx solid #edf1f6;
}

.power-copy {
  min-width: 0;
  padding-right: 12rpx;
}

.power-title,
.setting-title {
  color: #273f60;
  font-size: 25rpx;
  font-weight: 720;
}

.power-hint,
.setting-description {
  margin-top: 6rpx;
  color: #8797aa;
  font-size: 20rpx;
  line-height: 1.5;
}

.power-button {
  min-width: 146rpx;
  padding: 0 18rpx;
  line-height: 62rpx;
}

.power-on {
  color: #167b5b;
  background: #e4f8f0;
}

.power-off {
  color: #60728a;
  background: #edf1f6;
}

.section-heading {
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.section-title {
  color: #1b3456;
  font-size: 29rpx;
  font-weight: 780;
}

.live-chip {
  display: flex;
  align-items: center;
  padding: 9rpx 15rpx;
  border-radius: 24rpx;
  color: #198563;
  background: #e8f8f2;
  font-size: 19rpx;
  font-weight: 700;
}

.history-actions {
  display: flex;
  align-items: center;
  gap: 13rpx;
}

.clear-history {
  padding: 9rpx 15rpx;
  border-radius: 24rpx;
  color: #d9534f;
  background: #fdf1f1;
  font-size: 19rpx;
  font-weight: 700;
}

.live-chip-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  box-shadow: none;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13rpx;
}

.stat-tile {
  min-height: 142rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid transparent;
  border-radius: 17rpx;
}

.stat-blue {
  border-color: #dceaff;
  background: #f0f6ff;
}

.stat-purple {
  border-color: #e8e1ff;
  background: #f6f3ff;
}

.stat-orange {
  border-color: #ffe9d6;
  background: #fff7ef;
}

.stat-mint {
  border-color: #d9f1e8;
  background: #effaf5;
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 37rpx;
  height: 37rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #4389e9;
  font-size: 20rpx;
  font-weight: 700;
}

.stat-purple .stat-icon {
  background: #8c70db;
}

.stat-orange .stat-icon {
  background: #ec9a50;
}

.stat-mint .stat-icon {
  background: #38ad83;
}

.stat-number {
  margin-top: 12rpx;
  color: #1d3555;
  font-size: 31rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.stat-result {
  font-size: 27rpx;
}

.stat-label {
  margin-top: 4rpx;
  color: #8292a7;
  font-size: 19rpx;
}

.last-session {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 17rpx;
  padding: 17rpx 4rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.last-session-label {
  color: #8392a5;
  font-size: 21rpx;
}

.last-session-value {
  color: #375374;
  font-size: 21rpx;
  font-weight: 700;
}

.last-session-value text {
  color: #8292a7;
  font-weight: 500;
}

.history-row {
  display: flex;
  align-items: flex-start;
  padding: 17rpx 2rpx;
  border-top: 1rpx solid #edf1f6;
}

.history-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin: 8rpx 16rpx 0 4rpx;
  border-radius: 50%;
  background: #a9b8ca;
}

.history-dot-1 {
  background: #4a90e2;
}

.history-dot-2 {
  background: #28c69a;
}

.history-dot-3 {
  background: #ec9a50;
}

.history-dot-4 {
  background: #e05656;
}

.history-main {
  flex: 1;
  min-width: 0;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-type {
  color: #233d60;
  font-size: 24rpx;
  font-weight: 700;
}

.history-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.history-mode {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.6;
}

.history-mode.online {
  color: #167b5b;
  background: #e4f8f0;
}

.history-mode.offline {
  color: #8a6d3b;
  background: #faf3e3;
}

.history-time {
  color: #8b9cb0;
  font-size: 20rpx;
}

.history-summary {
  margin-top: 5rpx;
  color: #71869d;
  font-size: 21rpx;
  line-height: 1.5;
}

.settings-mark {
  padding: 9rpx 12rpx;
  border: 1rpx solid #dce9fa;
  border-radius: 9rpx;
  color: #6584ac;
  font-size: 16rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.setting-block {
  padding: 21rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.setting-heading {
  margin-bottom: 8rpx;
}

.volume-pill {
  padding: 7rpx 13rpx;
  border-radius: 12rpx;
  color: #226dce;
  background: #eaf3ff;
  font-size: 24rpx;
  font-weight: 800;
}

.volume-pill text {
  margin-left: 2rpx;
  font-size: 18rpx;
}

.volume-slider {
  margin: 15rpx 4rpx 0;
}

.frequency-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.awkward-frequency-heading {
  margin-top: 24rpx;
}

.frequency-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d6e5f8;
  border-radius: 14rpx;
  color: #226dce;
  background: #edf5ff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.frequency-button[disabled] {
  color: #a9b8ca;
  background: #f3f6fa;
}

.frequency-step {
  color: #73869d;
  font-size: 21rpx;
}

.level-options {
  display: flex;
  gap: 14rpx;
}

.level-option {
  flex: 1;
  padding: 16rpx 18rpx;
  border: 1rpx solid #d6e5f8;
  border-radius: 14rpx;
  background: #f5f9ff;
}

.vibration-effects {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.vibration-effect {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d6e5f8;
  border-radius: 14rpx;
  background: #f5f9ff;
  line-height: 1.4;
  text-align: left;
}

.vibration-effect::after {
  border: 0;
}

.vibration-effect[disabled] {
  opacity: .5;
}

.level-active {
  border-color: #2478f2;
  background: #eaf3ff;
}

.level-disabled {
  opacity: .5;
}

.level-name {
  color: #273f60;
  font-size: 24rpx;
  font-weight: 750;
}

.level-active .level-name {
  color: #226dce;
}

.level-detail {
  margin-top: 5rpx;
  color: #71869d;
  font-size: 20rpx;
}

.timing-block {
  padding-bottom: 0;
}

.delay-row {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  border-top: 1rpx solid #eff3f7;
}

.delay-order {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 37rpx;
  height: 37rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  color: #347bd4;
  background: #eaf3ff;
  font-size: 20rpx;
  font-weight: 750;
}

.delay-name {
  flex: 1;
  color: #4b627e;
  font-size: 22rpx;
}

.delay-input {
  width: 112rpx;
  padding: 11rpx 12rpx;
  border: 1rpx solid #d9e4f0;
  border-radius: 11rpx;
  color: #203b5d;
  background: #f9fbfe;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
}

.motor-control-group {
  margin-top: 24rpx;
}

.motor-control-group:first-child {
  margin-top: 0;
}

.motor-input-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
}

.motor-input-field {
  display: flex;
  min-width: 260rpx;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #dfe8f3;
  border-radius: 14rpx;
  color: #647a95;
  font-size: 22rpx;
}

.motor-carrier-field {
  max-width: 100%;
}

.motor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.motor-action-button {
  min-width: 0;
  flex: 1;
}

.motor-input {
  width: 120rpx;
  min-width: 0;
  padding: 8rpx 10rpx;
  border: 1rpx solid #d5e0ee;
  border-radius: 10rpx;
  color: #1c3454;
  font-size: 24rpx;
  text-align: center;
}

.unit {
  width: 68rpx;
  color: #8494a8;
  font-size: 19rpx;
  text-align: right;
}

.repeat-note {
  margin-top: 11rpx;
  padding: 13rpx 15rpx;
  border-radius: 11rpx;
  color: #66819e;
  background: #f2f7fd;
  font-size: 19rpx;
  line-height: 1.5;
}

.save-button {
  margin-top: 23rpx;
  line-height: 82rpx;
  font-size: 25rpx;
}

.manual-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.manual-trigger {
  flex: 1;
  line-height: 82rpx;
  font-size: 25rpx;
}

.manual-stop {
  width: 150rpx;
  line-height: 82rpx;
  font-size: 25rpx;
}

.save-state {
  min-height: 30rpx;
  margin-top: 13rpx;
  color: #73869d;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

.save-state.error {
  color: #d84b4b;
}

.footer-note {
  padding: 25rpx 16rpx 0;
  color: #8b9cb0;
  font-size: 19rpx;
  line-height: 1.6;
  text-align: center;
}
